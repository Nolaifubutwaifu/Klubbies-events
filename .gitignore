.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/test-results
/playwright-report
!.env.example

# Full-size marketing source photos (web crops live in public/marketing)
design/source-photos/

# Real faces, gathered once to tune the recognition thresholds. The method is
# in docs/face-tuning.md; the photos themselves are never committed.
tuning-photos/
