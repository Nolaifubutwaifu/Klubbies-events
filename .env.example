NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM=Klubbies <no-reply@klubbies.app>
APP_URL=http://localhost:3000
# Used to hash IP addresses in access_events and rate limits.
SIGNED_URL_SECRET=
# Stripe: secret key, the price clubs pay, and the webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Shown on the terms and refunds pages.
SUPPORT_EMAIL=
# Server errors are emailed here (throttled). Leave empty to only log.
ALERT_EMAIL=
# Vercel Cron sends this as a Bearer token to /api/cron/grace.
CRON_SECRET=
# Stripe publishable key for the card form (safe in the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Face recognition (AWS Rekognition), all optional. With no key the feature is
# simply off: the worker no-ops and no club can enable it.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# klubbies-dev locally, klubbies-prod in production. Collections are named
# {prefix}-club-{clubId}, so this keeps test faces out of real collections.
REKOGNITION_COLLECTION_PREFIX=klubbies-dev
