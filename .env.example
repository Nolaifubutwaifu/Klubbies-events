NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM=Klubbies <no-reply@klubbies.app>
APP_URL=http://localhost:3000
# Used to hash IP addresses in access_events and rate limits.
SIGNED_URL_SECRET=
# Stripe: secret key and the webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The tier prices (one-off, AUD) and Keep another year. Optional: without one,
# the amount comes from lib/billing/plans.ts, but then a promotion code limited
# to a product (FOUNDING25 to Medium) can't apply. STRIPE_PRICE_ID is no longer used.
STRIPE_PRICE_SMALL_CLUB=
STRIPE_PRICE_SMALL_STANDARD=
STRIPE_PRICE_MEDIUM_CLUB=
STRIPE_PRICE_MEDIUM_STANDARD=
STRIPE_PRICE_LARGE_CLUB=
STRIPE_PRICE_LARGE_STANDARD=
STRIPE_PRICE_KEEP_YEAR=
# Who can open /ops/usage besides platform super admins (comma separated).
OPS_EMAILS=
# Where the support page's contact form sends messages, and the Reply-To on
# every email. Never shown on the site (scrapers harvest it for spam).
SUPPORT_EMAIL=support@klubbies.app
# Server errors are emailed here (throttled). Leave empty to only log. Keep it
# separate from SUPPORT_EMAIL so alerts don't bury customer mail.
ALERT_EMAIL=alerts@klubbies.app
# Vercel Cron sends this as a Bearer token to /api/cron/hourly.
CRON_SECRET=
# Stripe publishable key for the card form (safe in the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Face recognition (AWS Rekognition), all optional. With no key the feature is
# simply off: the worker no-ops and no event can enable it.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# klubbies-dev locally, klubbies-prod in production. Collections are named
# {prefix}-event-{eventId}, so this keeps test faces out of real collections.
REKOGNITION_COLLECTION_PREFIX=klubbies-dev

# iPhone push notifications (optional; without them nothing is pushed).
# developer.apple.com > Certificates, Identifiers & Profiles > Keys > +,
# tick Apple Push Notifications service (APNs), download the .p8 once.
APNS_KEY_ID=
APNS_TEAM_ID=
# The whole .p8 file, including the BEGIN and END lines.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.klubbies.events

# Cloudflare R2: the second copy of every photo, and where full quality
# downloads, zips and video come from. All optional: with none set, backup
# quietly does nothing and everything is served from Supabase.
# A separate Cloudflare account, bucket klubbies-events-backup with the
# Oceania location hint, and an API token limited to that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=klubbies-events-backup

# Google Ads measurement (optional). Leave these empty and the site does not
# load the Google tag, does not set ads cookies, and does not send conversions.
# The tag id is AW- followed by 9 to 11 digits, from Google Ads > Goals >
# Conversions > tag setup. Example: AW-1234567890
NEXT_PUBLIC_GOOGLE_ADS_ID=
# The label is the part after the slash in the tag's send_to value
# (AW-1234567890/AbC-dEf). Each conversion is sent only when the tag id above
# is set and that label is set. A missing label means that event is not sent.
# Organiser creates an event. Fired once, after the server has saved the event.
NEXT_PUBLIC_GOOGLE_ADS_EVENT_CREATED_LABEL=
# Organiser creates an account (the email code on /start). Fired once per new
# account, not on later sign-ins. This step is separate from creating an event.
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
