        "pnpm",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "klubbies-dev-3200",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EMAIL_DRY_RUN=1",
        "APP_URL=http://localhost:3200",
        "pnpm",
        "next",
