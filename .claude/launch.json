{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "klubbies-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "klubbies-dev-3100",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3100"
      ],
